# Circle Arc Blockchain Application - Environment Variables Template
# Copy this file to .env and fill in your values

# Wallet Configuration
# Your wallet's private key (64 hex characters, without 0x prefix)
# IMPORTANT: Never commit your actual private key to version control!
WALLET_PRIVATE_KEY=

# Example:
# WALLET_PRIVATE_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Server Configuration (optional)
# SERVER_PORT=8080

# Logging Level (optional)
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_APP=DEBUG
